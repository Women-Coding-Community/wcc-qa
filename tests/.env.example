# Copy this file to `.env`. Never commit `.env`.
#
# The values below are the local Docker stack's public defaults (`npm run env:up`),
# not secrets — copy as-is to run against it. Point them elsewhere for another environment.

# Backend API
API_HOST=http://localhost:8080
API_KEY=local

# Admin portal (UI tests and the login setup)
ADMIN_BASE_URL=http://localhost:3000

# Role credentials (per-role API fixtures and the admin login setup)
ADMIN_EMAIL=admin@wcc.dev
ADMIN_PASSWORD=wcc-admin

LEADER_EMAIL=leader@wcc.dev
LEADER_PASSWORD=wcc-admin

MENTOR_EMAIL=mentor@wcc.dev
MENTOR_PASSWORD=wcc-admin

MENTORSHIP_ADMIN_EMAIL=mentorship-admin@wcc.dev
MENTORSHIP_ADMIN_PASSWORD=wcc-admin

# Only for the @ad-hoc phase of `npm test`: where wcc-backend is checked out, relative to this repo.
# WCC_BACKEND_DIR=../wcc-backend
